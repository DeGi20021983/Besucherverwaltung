# Apache-Konfiguration für das öffentliche Verzeichnis (DocumentRoot = public/)
# Benötigte Module: mod_headers, mod_rewrite (optional: mod_deflate, mod_expires)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Versteckte Dateien (.htaccess, .git …) sperren
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Nur die vorgesehenen PHP-Seiten ausführen
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "^(index|bestaetigung|bearbeiten|pforte)\.php$">
    Require all granted
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS erzwingen (hinter einem Reverse-Proxy ggf. anpassen).
    # Ausnahme: lokaler Test auf dem eigenen Rechner (z. B. mit XAMPP) über http://localhost
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    # Sicherheits-Header auch für statische Dateien (PHP-Seiten setzen sie zusätzlich selbst)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always setifempty Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
</IfModule>
