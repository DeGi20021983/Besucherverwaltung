# Apache-Konfiguration für das öffentliche Verzeichnis (DocumentRoot = public/)

Options -Indexes -MultiViews
DirectoryIndex index.php

# Nur HTTPS: unverschlüsselte Aufrufe umleiten
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Versteckte Dateien (.htaccess, .git …) nie ausliefern
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Sicherheits-Header für statische Dateien (CSS/JS).
# Die PHP-Seiten setzen ihre Header selbst (gilt so auch unter nginx).
<IfModule mod_headers.c>
<FilesMatch "\.(css|js)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</FilesMatch>
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors off
    php_flag expose_php off
</IfModule>
