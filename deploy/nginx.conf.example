# Beispielkonfiguration für nginx + PHP-FPM
# Pfade, Domain und PHP-FPM-Socket anpassen, dann z. B. nach
# /etc/nginx/sites-available/besucheranmeldung kopieren und aktivieren.

server {
    listen 80;
    listen [::]:80;
    server_name besuch.example.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name besuch.example.de;

    ssl_certificate     /etc/letsencrypt/live/besuch.example.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/besuch.example.de/privkey.pem;

    # Nur das Verzeichnis public/ ist öffentlich erreichbar.
    root /var/www/besucheranmeldung/public;
    index index.php;
    charset utf-8;

    # Keine Zugriffs-Logs mit IP-Adressen und Token-URLs (Datenschutz)
    access_log off;

    server_tokens off;
    client_max_body_size 1m;

    # Sicherheits-Header (PHP-Seiten setzen sie zusätzlich selbst)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Versteckte Dateien sperren
    location ~ /\. {
        deny all;
    }

    # Nur die vorgesehenen PHP-Seiten ausführen
    location ~ ^/(index|bestaetigung|bearbeiten|pforte)\.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # Alle anderen PHP-Dateien sperren
    location ~ \.php$ {
        return 404;
    }

    location /assets/ {
        add_header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        expires 1d;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
